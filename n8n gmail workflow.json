{
  "name": "Gmail Labels → Sheets + Drive (Label/Date/Sender)",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": false,
        "filters": {
          "labelIds": [
            "Label_1",
            "Label_2",
            "Label_3"
          ]
        },
        "options": {
          "downloadAttachments": true
        }
      },
      "id": "gmail-trigger",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [0, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "fromName",
              "name": "fromName",
              "value": "={{ ($json.from?.value?.[0]?.name || $json.from?.text?.split('<')[0] || 'Unknown').replace(/[<>:\"/\\\\|?*]/g, '').trim() || 'Unknown' }}",
              "type": "string"
            },
            {
              "id": "fromEmail",
              "name": "fromEmail",
              "value": "={{ $json.from?.value?.[0]?.address || $json.from?.text?.match(/<(.+)>/)?.[1] || $json.from || '' }}",
              "type": "string"
            },
            {
              "id": "subject",
              "name": "subject",
              "value": "={{ $json.subject || '' }}",
              "type": "string"
            },
            {
              "id": "receivedDate",
              "name": "receivedDate",
              "value": "={{ $json.date ? new Date($json.date).toISOString().slice(0,10) : $now.toISO().slice(0,10) }}",
              "type": "string"
            },
            {
              "id": "labelName",
              "name": "labelName",
              "value": "={{ $json.labelIds?.[0] || 'NoLabel' }}",
              "type": "string"
            },
            {
              "id": "messageId",
              "name": "messageId",
              "value": "={{ $json.id }}",
              "type": "string"
            },
            {
              "id": "hasAttachments",
              "name": "hasAttachments",
              "value": "={{ Object.keys($binary || {}).length > 0 }}",
              "type": "boolean"
            },
            {
              "id": "attachmentCount",
              "name": "attachmentCount",
              "value": "={{ Object.keys($binary || {}).length }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "prepare-data",
      "name": "Prepare Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [260, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Date": "={{ $json.receivedDate }}",
            "From Name": "={{ $json.fromName }}",
            "From Email": "={{ $json.fromEmail }}",
            "Subject": "={{ $json.subject }}",
            "Label": "={{ $json.labelName }}",
            "Message ID": "={{ $json.messageId }}",
            "Has Attachments": "={{ $json.hasAttachments }}",
            "Attachment Count": "={{ $json.attachmentCount }}"
          }
        },
        "options": {}
      },
      "id": "google-sheets",
      "name": "Append to Google Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [520, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-attachments",
              "leftValue": "={{ $json.hasAttachments }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-attachments",
      "name": "Has Attachments?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [780, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "={{ Object.keys($binary) }}",
        "include": "allOtherFields",
        "options": {}
      },
      "id": "split-attachments",
      "name": "Split Attachments",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [1040, 200]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "operation": "search",
        "queryString": "=name = '{{ $('Prepare Data').item.json.labelName }}' and mimeType = 'application/vnd.google-apps.folder' and trashed = false",
        "options": {
          "fields": ["id", "name"]
        }
      },
      "id": "search-label-folder",
      "name": "Search Label Folder",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1300, 100],
      "alwaysOutputData": true,
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "YOUR_DRIVE_CREDENTIAL_ID",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "label-exists",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-label-exists",
      "name": "Label Folder Exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1520, 100]
    },
    {
      "parameters": {
        "resource": "folder",
        "operation": "create",
        "name": "={{ $('Prepare Data').item.json.labelName }}",
        "options": {}
      },
      "id": "create-label-folder",
      "name": "Create Label Folder",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1740, 200],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "YOUR_DRIVE_CREDENTIAL_ID",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineAll",
        "options": {}
      },
      "id": "merge-label",
      "name": "Merge Label ID",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.1,
      "position": [1960, 100]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "operation": "search",
        "queryString": "=name = '{{ $('Prepare Data').item.json.receivedDate }}' and mimeType = 'application/vnd.google-apps.folder' and '{{ $json.id }}' in parents and trashed = false",
        "options": {
          "fields": ["id", "name"]
        }
      },
      "id": "search-date-folder",
      "name": "Search Date Folder",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [2180, 100],
      "alwaysOutputData": true,
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "YOUR_DRIVE_CREDENTIAL_ID",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "date-exists",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-date-exists",
      "name": "Date Folder Exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2400, 100]
    },
    {
      "parameters": {
        "resource": "folder",
        "operation": "create",
        "name": "={{ $('Prepare Data').item.json.receivedDate }}",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Merge Label ID').item.json.id }}"
        },
        "options": {}
      },
      "id": "create-date-folder",
      "name": "Create Date Folder",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [2620, 200],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "YOUR_DRIVE_CREDENTIAL_ID",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineAll",
        "options": {}
      },
      "id": "merge-date",
      "name": "Merge Date ID",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.1,
      "position": [2840, 100]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "operation": "search",
        "queryString": "=name = '{{ $('Prepare Data').item.json.fromName }}' and mimeType = 'application/vnd.google-apps.folder' and '{{ $json.id }}' in parents and trashed = false",
        "options": {
          "fields": ["id", "name"]
        }
      },
      "id": "search-sender-folder",
      "name": "Search Sender Folder",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [3060, 100],
      "alwaysOutputData": true,
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "YOUR_DRIVE_CREDENTIAL_ID",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "sender-exists",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-sender-exists",
      "name": "Sender Folder Exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [3280, 100]
    },
    {
      "parameters": {
        "resource": "folder",
        "operation": "create",
        "name": "={{ $('Prepare Data').item.json.fromName }}",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Merge Date ID').item.json.id }}"
        },
        "options": {}
      },
      "id": "create-sender-folder",
      "name": "Create Sender Folder",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [3500, 200],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "YOUR_DRIVE_CREDENTIAL_ID",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineAll",
        "options": {}
      },
      "id": "merge-sender",
      "name": "Merge Sender ID",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.1,
      "position": [3720, 100]
    },
    {
      "parameters": {
        "name": "={{ $binary[$binary.keys()[0]].fileName }}",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.id }}"
        },
        "options": {
          "binaryData": true
        },
        "inputDataFieldName": "={{ $binary.keys()[0] }}"
      },
      "id": "upload-file",
      "name": "Upload Attachment",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [3940, 100],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "YOUR_DRIVE_CREDENTIAL_ID",
          "name": "Google Drive account"
        }
      }
    }
  ],
  "connections": {
